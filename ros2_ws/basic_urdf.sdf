<?xml version="1.0" ?>
<sdf version="1.8">
    <world name="pioneer_world">

        <!-- Physics setup for the simulation -->
        <physics name="1ms" type="ignored">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>

        <!-- Core Gazebo simulation systems -->
        <plugin
            filename="libgz-sim-physics-system"
            name="gz::sim::systems::Physics">
        </plugin>
        <plugin
            filename="libgz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
        </plugin>
        <plugin
            filename="libgz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
        </plugin>
        <plugin filename="libgz-sim-imu-system"
                name="gz::sim::systems::Imu">
        </plugin>
        <plugin filename="libgz-sim-sensors-system.so"
                name="gz::sim::systems::Sensors">
        </plugin>
        <plugin filename="libgz-sim-contact-system"
                name="gz::sim::systems::Contact">
        </plugin>

        <!-- Sun / lighting for the world -->
        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <!-- Code for the base ground plane -->
        <!-- This is the full flat area the whole world sits on -->
        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                        </plane>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.65 0.65 0.65 1</ambient>
                        <diffuse>0.65 0.65 0.65 1</diffuse>
                        <specular>0.2 0.2 0.2 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Code for the grass field -->
        <!-- This is the green area that makes it feel more like James Oval -->
        <model name="grass_field">
            <static>true</static>
            <pose>0 0 0.01 0 0 0</pose>
            <link name="field_link">
                <visual name="field_visual">
                    <geometry>
                        <box>
                            <size>26 18 0.02</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.18 0.55 0.18 1</ambient>
                        <diffuse>0.18 0.55 0.18 1</diffuse>
                        <specular>0.05 0.05 0.05 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Code for centre cricket pitch strip -->
        <!-- This is the brown rectangle placed in the middle of the oval -->
        <!-- pose puts it in the centre of the map -->
        <!-- the small z value lifts it slightly above the grass so it is visible -->
        <!-- box size makes it long and narrow like a cricket pitch -->
        <model name="cricket_pitch_strip">
            <static>true</static>
            <pose>0 0 0.02 0 0 0</pose>
            <link name="pitch_link">
                <visual name="pitch_visual">
                    <geometry>
                        <box>
                            <size>1.2 8.0 0.03</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.65 0.52 0.32 1</ambient>
                        <diffuse>0.65 0.52 0.32 1</diffuse>
                        <specular>0.1 0.1 0.1 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- ========================================================= -->
        <!-- OVAL OUTLINE                                              -->
        <!-- These are only visual white line markers.                 -->
        <!-- They show the oval shape but do not block the robot.      -->
        <!-- ========================================================= -->

        <!-- Code for oval outline marker at top centre [0, 7] -->
        <model name="oval_line_1">
            <static>true</static>
            <pose>0 7 0.02 0 0 0</pose>
            <link name="link">
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>5.0 0.15 0.02</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>1 1 1 1</ambient>
                        <diffuse>1 1 1 1</diffuse>
                        <specular>0.2 0.2 0.2 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Code for oval outline marker at upper right [4.5, 5.8] -->
        <model name="oval_line_2">
            <static>true</static>
            <pose>4.5 5.8 0.02 0 0 -0.45</pose>
            <link name="link">
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>4.0 0.15 0.02</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>1 1 1 1</ambient>
                        <diffuse>1 1 1 1</diffuse>
                        <specular>0.2 0.2 0.2 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Code for oval outline marker at right upper side [7, 3.5] -->
        <model name="oval_line_3">
            <static>true</static>
            <pose>7 3.5 0.02 0 0 -0.95</pose>
            <link name="link">
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>3.5 0.15 0.02</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>1 1 1 1</ambient>
                        <diffuse>1 1 1 1</diffuse>
                        <specular>0.2 0.2 0.2 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Code for oval outline marker at right centre [7.5, 0] -->
        <model name="oval_line_4">
            <static>true</static>
            <pose>7.5 0 0.02 0 0 -1.57</pose>
            <link name="link">
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>3.0 0.15 0.02</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>1 1 1 1</ambient>
                        <diffuse>1 1 1 1</diffuse>
                        <specular>0.2 0.2 0.2 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Code for oval outline marker at right lower side [7, -3.5] -->
        <model name="oval_line_5">
            <static>true</static>
            <pose>7 -3.5 0.02 0 0 -2.15</pose>
            <link name="link">
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>3.5 0.15 0.02</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>1 1 1 1</ambient>
                        <diffuse>1 1 1 1</diffuse>
                        <specular>0.2 0.2 0.2 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Code for oval outline marker at lower right [4.5, -5.8] -->
        <model name="oval_line_6">
            <static>true</static>
            <pose>4.5 -5.8 0.02 0 0 -2.7</pose>
            <link name="link">
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>4.0 0.15 0.02</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>1 1 1 1</ambient>
                        <diffuse>1 1 1 1</diffuse>
                        <specular>0.2 0.2 0.2 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Code for oval outline marker at bottom centre [0, -7] -->
        <model name="oval_line_7">
            <static>true</static>
            <pose>0 -7 0.02 0 0 0</pose>
            <link name="link">
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>5.0 0.15 0.02</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>1 1 1 1</ambient>
                        <diffuse>1 1 1 1</diffuse>
                        <specular>0.2 0.2 0.2 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Code for oval outline marker at lower left [-4.5, -5.8] -->
        <model name="oval_line_8">
            <static>true</static>
            <pose>-4.5 -5.8 0.02 0 0 2.7</pose>
            <link name="link">
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>4.0 0.15 0.02</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>1 1 1 1</ambient>
                        <diffuse>1 1 1 1</diffuse>
                        <specular>0.2 0.2 0.2 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Code for oval outline marker at left lower side [-7, -3.5] -->
        <model name="oval_line_9">
            <static>true</static>
            <pose>-7 -3.5 0.02 0 0 2.15</pose>
            <link name="link">
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>3.5 0.15 0.02</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>1 1 1 1</ambient>
                        <diffuse>1 1 1 1</diffuse>
                        <specular>0.2 0.2 0.2 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Code for oval outline marker at left centre [-7.5, 0] -->
        <model name="oval_line_10">
            <static>true</static>
            <pose>-7.5 0 0.02 0 0 1.57</pose>
            <link name="link">
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>3.0 0.15 0.02</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>1 1 1 1</ambient>
                        <diffuse>1 1 1 1</diffuse>
                        <specular>0.2 0.2 0.2 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Code for oval outline marker at left upper side [-7, 3.5] -->
        <model name="oval_line_11">
            <static>true</static>
            <pose>-7 3.5 0.02 0 0 0.95</pose>
            <link name="link">
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>3.5 0.15 0.02</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>1 1 1 1</ambient>
                        <diffuse>1 1 1 1</diffuse>
                        <specular>0.2 0.2 0.2 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Code for oval outline marker at upper left [-4.5, 5.8] -->
        <model name="oval_line_12">
            <static>true</static>
            <pose>-4.5 5.8 0.02 0 0 0.45</pose>
            <link name="link">
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>4.0 0.15 0.02</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>1 1 1 1</ambient>
                        <diffuse>1 1 1 1</diffuse>
                        <specular>0.2 0.2 0.2 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Code for cricket batting cage frame at location [0, -11] -->
        <model name="batting_cage_1">
            <static>true</static>
            <pose>0 -11 0 0 0 0</pose>
            <link name="link">

                <visual name="lane_visual">
                    <pose>0 0 1.0 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>1.5 6.0 2.0</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.7 0.7 0.7 0.15</ambient>
                        <diffuse>0.7 0.7 0.7 0.15</diffuse>
                    </material>
                </visual>

                <visual name="post_front_left">
                    <pose>-0.75 3.0 1.0 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>0.08 0.08 2.0</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.3 0.3 0.3 1</ambient>
                        <diffuse>0.3 0.3 0.3 1</diffuse>
                    </material>
                </visual>

                <visual name="post_front_right">
                    <pose>0.75 3.0 1.0 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>0.08 0.08 2.0</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.3 0.3 0.3 1</ambient>
                        <diffuse>0.3 0.3 0.3 1</diffuse>
                    </material>
                </visual>

                <visual name="post_back_left">
                    <pose>-0.75 -3.0 1.0 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>0.08 0.08 2.0</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.3 0.3 0.3 1</ambient>
                        <diffuse>0.3 0.3 0.3 1</diffuse>
                    </material>
                </visual>

                <visual name="post_back_right">
                    <pose>0.75 -3.0 1.0 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>0.08 0.08 2.0</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.3 0.3 0.3 1</ambient>
                        <diffuse>0.3 0.3 0.3 1</diffuse>
                    </material>
                </visual>

                <visual name="top_bar_left">
                    <pose>-0.75 0 2.0 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>0.08 6.0 0.08</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.3 0.3 0.3 1</ambient>
                        <diffuse>0.3 0.3 0.3 1</diffuse>
                    </material>
                </visual>

                <visual name="top_bar_right">
                    <pose>0.75 0 2.0 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>0.08 6.0 0.08</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.3 0.3 0.3 1</ambient>
                        <diffuse>0.3 0.3 0.3 1</diffuse>
                    </material>
                </visual>

                <collision name="collision">
                    <pose>0 0 1.0 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>1.5 6.0 2.0</size>
                        </box>
                    </geometry>
                </collision>

            </link>
        </model>

        <!-- Code for second cricket batting cage at location [2.5, -11] -->
        <model name="batting_cage_2">
            <static>true</static>
            <pose>2.5 -11 0 0 0 0</pose>
            <link name="link">

                <visual name="lane_visual">
                    <pose>0 0 1.0 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>1.5 6.0 2.0</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.7 0.7 0.7 0.15</ambient>
                        <diffuse>0.7 0.7 0.7 0.15</diffuse>
                    </material>
                </visual>

                <visual name="post_front_left">
                    <pose>-0.75 3.0 1.0 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>0.08 0.08 2.0</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.3 0.3 0.3 1</ambient>
                        <diffuse>0.3 0.3 0.3 1</diffuse>
                    </material>
                </visual>

                <visual name="post_front_right">
                    <pose>0.75 3.0 1.0 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>0.08 0.08 2.0</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.3 0.3 0.3 1</ambient>
                        <diffuse>0.3 0.3 0.3 1</diffuse>
                    </material>
                </visual>

                <visual name="post_back_left">
                    <pose>-0.75 -3.0 1.0 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>0.08 0.08 2.0</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.3 0.3 0.3 1</ambient>
                        <diffuse>0.3 0.3 0.3 1</diffuse>
                    </material>
                </visual>

                <visual name="post_back_right">
                    <pose>0.75 -3.0 1.0 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>0.08 0.08 2.0</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.3 0.3 0.3 1</ambient>
                        <diffuse>0.3 0.3 0.3 1</diffuse>
                    </material>
                </visual>

                <visual name="top_bar_left">
                    <pose>-0.75 0 2.0 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>0.08 6.0 0.08</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.3 0.3 0.3 1</ambient>
                        <diffuse>0.3 0.3 0.3 1</diffuse>
                    </material>
                </visual>

                <visual name="top_bar_right">
                    <pose>0.75 0 2.0 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>0.08 6.0 0.08</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.3 0.3 0.3 1</ambient>
                        <diffuse>0.3 0.3 0.3 1</diffuse>
                    </material>
