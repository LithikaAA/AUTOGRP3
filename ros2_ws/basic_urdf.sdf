                <collision name="collision">
                    <pose>0 0 1.0 0 0 0</pose>
                    <geometry>
                        <box>
                            <size>1.5 6.0 2.0</size>
                        </box>
                    </geometry>
                </collision>

            </link>
        </model>

    </world>
</sdf>